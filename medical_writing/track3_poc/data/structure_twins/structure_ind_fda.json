      "source_elements": ["design_type", "inclusion_criteria", "primary_endpoint"],
      "judgment_complexity": "high",
      "role_primary": ["clinical_science", "regulatory_affairs"],
      "ordering": 3
    },
    {
      "section_id": "cmc_information",
      "section_title": "Chemistry, Manufacturing, and Control Information",
      "required": true,
      "regulatory_authority": "21 CFR 312.23(a)(7)",
      "content_expectations": [
