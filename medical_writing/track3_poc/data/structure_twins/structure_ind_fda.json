      "source_elements": ["drug_name", "indication", "mechanism_of_action"],
      "judgment_complexity": "low",
      "role_primary": ["regulatory_affairs"],
      "ordering": 1
    },
    {
      "section_id": "investigators_brochure_ref",
      "section_title": "Investigator's Brochure",
      "required": true,
      "regulatory_authority": "21 CFR 312.23(a)(5)",
      "content_expectations": [
        "Summary of pharmacological and toxicological effects",
        "Summary of pharmacokinetics and biological disposition",
        "Safety and effectiveness information from prior human experience"
      ],
      "source_elements": ["drug_name", "safety_summary"],
      "judgment_complexity": "medium",
      "role_primary": ["regulatory_affairs", "clinical_science"],
      "ordering": 2
    },
    {
